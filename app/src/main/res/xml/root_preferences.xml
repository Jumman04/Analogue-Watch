<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ===================== -->
    <!-- MARKERS -->
    <!-- ===================== -->
    <PreferenceCategory app:title="Marker">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="minuteMarker"
            app:title="Minute Marker" />

        <SeekBarPreference
            android:defaultValue="5"
            android:max="100"
            app:dependency="minuteMarker"
            app:key="minuteMarkerHeight"
            app:title="Minute Marker Height" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="hourMarker"
            app:title="Hour Marker" />

        <SeekBarPreference
            android:defaultValue="10"
            android:max="100"
            app:dependency="hourMarker"
            app:key="hourMarkerHeight"
            app:title="Hour Marker Height" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="hourMarkerText"
            app:title="Hour Marker Text" />

        <SeekBarPreference
            android:defaultValue="22"
            android:max="100"
            android:min="10"
            app:dependency="hourMarkerText"
            app:key="markerTextSize"
            app:showSeekBarValue="true"
            app:title="Marker Text Size" />

    </PreferenceCategory>


    <!-- ===================== -->
    <!-- HANDS -->
    <!-- ===================== -->
    <PreferenceCategory app:title="Hands">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="secondHand"
            app:title="Second Hand" />

        <SeekBarPreference
            android:defaultValue="80"
            android:max="100"
            app:dependency="secondHand"
            app:key="secondHandHeight"
            app:title="Second Hand Height" />

        <SeekBarPreference
            android:defaultValue="2"
            android:max="100"
            app:dependency="secondHand"
            app:key="secondHandWidth"
            app:title="Second Hand Width" />


        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="minuteHand"
            app:title="Minute Hand" />

        <SeekBarPreference
            android:defaultValue="60"
            android:max="100"
            app:dependency="minuteHand"
            app:key="minuteHandHeight"
            app:title="Minute Hand Height" />

        <SeekBarPreference
            android:defaultValue="3"
            android:max="100"
            app:dependency="minuteHand"
            app:key="minuteHandWidth"
            app:title="Minute Hand Width" />


        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="hourHand"
            app:title="Hour Hand" />

        <SeekBarPreference
            android:defaultValue="50"
            android:max="100"
            app:dependency="hourHand"
            app:key="hourHandHeight"
            app:title="Hour Hand Height" />

        <SeekBarPreference
            android:defaultValue="4"
            android:max="100"
            app:dependency="hourHand"
            app:key="hourHandWidth"
            app:title="Hour Hand Width" />

    </PreferenceCategory>


    <!-- ===================== -->
    <!-- FRAME + APPEARANCE -->
    <!-- ===================== -->
    <PreferenceCategory app:title="Frame">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="frame"
            app:title="Clock Frame" />

    </PreferenceCategory>


    <!-- ===================== -->
    <!-- COLORS -->
    <!-- ===================== -->
    <PreferenceCategory app:title="Colors">

        <net.margaritov.preference.colorpicker.ColorPickerPreference
            android:defaultValue="#FEF7FF"
            android:key="backgroundColor"
            android:title="Background Color" />

        <net.margaritov.preference.colorpicker.ColorPickerPreference
            android:defaultValue="#1D1B20"
            android:key="primaryColor"
            android:title="Primary Color" />

        <net.margaritov.preference.colorpicker.ColorPickerPreference
            android:defaultValue="#C90000"
            android:key="secondaryColor"
            android:title="Second Hand Color" />

        <net.margaritov.preference.colorpicker.ColorPickerPreference
            android:defaultValue="#000000"
            android:key="textColor"
            android:title="Text Color" />

    </PreferenceCategory>


    <!-- ===================== -->
    <!-- SOUND -->
    <!-- ===================== -->
    <PreferenceCategory app:title="Sound">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="sound"
            app:title="Clock Sound" />

        <SeekBarPreference
            android:defaultValue="1"
            android:max="10"
            app:dependency="sound"
            app:key="volume"
            app:title="Sound Volume" />

    </PreferenceCategory>


    <!-- ===================== -->
    <!-- RESET -->
    <!-- ===================== -->
    <PreferenceCategory app:title="Reset">

        <Preference
            app:key="clear"
            app:title="Reset to Default" />

    </PreferenceCategory>


    <!-- ===================== -->
    <!-- ABOUT -->
    <!-- ===================== -->
    <PreferenceCategory app:title="About">

        <Preference
            app:key="website"
            app:title="Website" />

        <Preference
            app:key="more_apps"
            app:title="More Apps" />

        <Preference
            app:key="about"
            app:title="About Developer" />

        <Preference
            android:enabled="false"
            app:key="version"
            app:title="@string/versionName" />

    </PreferenceCategory>

</PreferenceScreen>